{
  "manifest_version": 3,
  "name": "E-Alerte - Alerte sites signalés",
  "description": "Affiche une alerte quand vous visitez un site déjà signalé comme potentiellement problématique.",
  "version": "1.1.4",
  "icons": {
    "192": "icon-192x192.png"
  },
  "permissions": ["tabs", "storage", "alarms", "scripting", "contextMenus"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "E-Alerte - Surveillance",
    "default_popup": "popup.html",
    "default_icon": "icon-192x192.png"
  }
}