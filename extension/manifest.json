{
  "manifest_version": 3,
  "name": "E-Alerte - Alerte sites signalés",
  "description": "Affiche une alerte quand vous visitez un site déjà signalé comme potentiellement problématique.",
  "version": "1.0.0",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "E-Alerte - Surveillance"
  }
}